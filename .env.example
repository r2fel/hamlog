# These four are optional here — the app now also asks for them itself on
# first run (and lets you change them later from DATA), and that in-app copy
# takes priority over whatever's below. Filling them in here is only useful
# for a headless/hosted deployment where nobody will click through the setup
# screen.
#
# QRZ.RU — dedicated XML API login/password (issued via
# https://www.qrz.ru/personal/settings/apiuser — this is NOT your regular
# site login/password). This is the primary lookup source.
QRZRU_USERNAME=your_qrzru_api_username
QRZRU_PASSWORD=your_qrzru_api_password

# QRZ.com — optional fallback, only used if a callsign isn't found on QRZ.RU.
# Leave blank if you don't have a QRZ.com account. A paid XML subscription is
# not strictly required — a regular account still returns basic fields.
QRZCOM_USERNAME=
QRZCOM_PASSWORD=

PORT=4173

# Set to 1 to print raw XML responses from QRZ.RU / QRZ.com in the server console.
# Useful when a callsign isn't being found as expected.
DEBUG=0

# Access code — required once the app is reachable from the internet.
# Anyone who opens the URL must enter this before lookups work.
# Leave blank for laptop-only use.
ACCESS_KEY=
